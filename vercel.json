{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/axel-materials.js": {
      "includeFiles": "private/materials/axel-service-guide.pdf",
      "maxDuration": 20
    }
  },
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/materials/axel-service-guide.pdf",
      "destination": "/axel#materials",
      "permanent": false
    },
    {
      "source": "/leadtoss",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/business",
      "destination": "/#business",
      "permanent": true
    },
    {
      "source": "/philosophy",
      "destination": "/#philosophy",
      "permanent": true
    }
  ]
}
