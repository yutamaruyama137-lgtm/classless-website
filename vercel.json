{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/axel",
      "destination": "/#ai",
      "permanent": true
    },
    {
      "source": "/leadtoss",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/business",
      "destination": "/#business",
      "permanent": true
    },
    {
      "source": "/philosophy",
      "destination": "/#philosophy",
      "permanent": true
    }
  ]
}
